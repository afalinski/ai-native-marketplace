{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}",
        "X-MCP-Toolsets": "repos,issues,pull_requests,actions"
      }
    },
    "eshop": {
      "type": "http",
      "url": "http://localhost:5230/mcp"
    }
  }
}
